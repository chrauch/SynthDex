    "q":
    {
        "runs": 10,
        "elem":
        {
            "max-cnt": 9
        },
        "gen":
        {
            "combine-all-workloads": true,
            "shuffle-workloads": true,
            "num": 10000,
            "expand":
            {
                "seed": -1,
#                "seed": 8,
                "mutation-rate-pct": 10
            },
            "max-gen-tries": 15000,
            "patterns-active":
            [
#                "BASE",

#                "LOW",
#                "HIGH",

#                "SHORT",
#                "LONG",

#                "FEW",
#                "MANY",

                "RND"
            ],
            "workload":
