                "COLDB":
                {
                    "ratio": 100,
                    "elem":
                    {
                        "cnt": [3],
                        "freqs": [ "1-100" ]
                    },
                    "ext":
                    {
                        "ranges": [ "0-0.001", "0.001-0.01", "0.01-0.1" ],
                        "skew": [ "0-80" ]
                    }
                },

                # Mid zone for 3-partition (1HOTB+1MIDA+1COLDB).
                # Covers the frequency and range gap between HOTB and COLDB with free skew.
                "MIDA":
                {
                    "ratio": 100,
                    "elem":
                    {
                        "cnt": [3],
                        "freqs": [ "0.01-0.1", "0.1-1" ]
                    },
                    "ext":
                    {
                        "ranges": [ "0.001-0.01", "0.01-0.1", "0.1-1" ],
                        "skew": [ "0-100" ]
                    }
                },

                # Upper mid zone (near-hot) for 4-partition (1HOTB+1MIDHA+1MIDLA+1COLDB).
                # Moderate-rare elements, medium-long ranges, leans toward recent skew.
                "MIDHA":
                {
                    "ratio": 100,
                    "elem":
                    {
                        "cnt": [3],
                        "freqs": [ "0.001-0.1" ]
                    },
                    "ext":
                    {
                        "ranges": [ "0.1-1", "1-10" ],
                        "skew": [ "50-100" ]
                    }
                },

                # Lower mid zone (near-cold) for 4-partition.
                # Moderate-common elements, medium-short ranges, leans toward historical skew.
                "MIDLA":
                {
                    "ratio": 100,
                    "elem":
                    {
                        "cnt": [3],
                        "freqs": [ "0.01-10" ]
                    },
                    "ext":
                    {
                        "ranges": [ "0.001-0.01", "0.01-0.1" ],
                        "skew": [ "0-60" ]
                    }
                },

