                    "ratio": 100,
                    "elem":
                    {
                        "cnt": [3],
                        "freqs": [ "0-100" ]
                    },
                    "ext":
                    {
                        "ranges": [ "0.1" ],
                        "skew": [ "0-100" ]
                    }
                },
                "LOW":
