                        "ranges": [ "0.1-1", "1-10", "10-100" ],
                        "skew": [ "90-100" ]
                    }
                },

                # 4-band hot zone
                "HOTB4":
                {
                    "ratio": 100,
                    "elem":
                    {
                        "cnt": [3],
                        "freqs": [ "0-0.01" ]
                    },
                    "ext":
                    {
                        "ranges": [ "0.001-0.01", "0.1-1", "1-10", "10-100" ],
                        "skew": [ "90-100" ]
                    }
